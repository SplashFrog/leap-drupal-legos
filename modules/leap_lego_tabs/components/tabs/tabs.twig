<div class="sf-lego-tabs">
  {% if title %}
    <h3 class="mb-4">{{ title }}</h3>
  {% endif %}
  
  {% if body %}
    <div class="mb-4">{{ body }}</div>
  {% endif %}

  <ul class="nav nav-tabs" id="{{ id }}" role="tablist">
    {% for item in items %}
      <li class="nav-item" role="presentation">
        <button class="nav-link {{ loop.first ? 'active' : '' }}" 
                id="tab-{{ item.id }}" 
                data-bs-toggle="tab" 
                data-bs-target="#pane-{{ item.id }}" 
                type="button" 
                role="tab" 
                aria-controls="pane-{{ item.id }}" 
                aria-selected="{{ loop.first ? 'true' : 'false' }}">
          {{ item.title }}
        </button>
      </li>
    {% endfor %}
  </ul>
  <div class="tab-content" id="{{ id }}Content">
    {% for item in items %}
      <div class="tab-pane fade {{ loop.first ? 'show active' : '' }}" 
           id="pane-{{ item.id }}" 
           role="tabpanel" 
           aria-labelledby="tab-{{ item.id }}" 
           tabindex="0">
        <div class="py-4">
          {{ item.content }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
