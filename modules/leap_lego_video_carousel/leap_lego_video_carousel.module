<?php

/**
 * @file
 */

declare(strict_types=1);

/**
 * @file
 * Hook implementations for the LEAP Lego - Video Carousel module.
 *
 * This module acts as the bridge between Drupal's backend data structures
 * (Block Content entities) and the frontend Single Directory Component (SDC)
 * templates. Unlike the Image Carousel which uses paragraphs, this module
 * extracts and renders referenced Media entities (Videos) directly.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 *
 * Provides instructions to site builders on how to complete the installation
 * of the Video Carousel Lego by applying the accompanying Drupal Recipe.
 */
function leap_lego_video_carousel_help(string $route_name, RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.leap_lego_video_carousel') {
    $module_path = \Drupal::service('extension.list.module')->getPath('leap_lego_video_carousel');
    $command = "drush recipe $module_path/recipes/leap_lego_video_carousel";

    $output = '<h3>' . t('About') . '</h3>';
    $output .= '<p>' . t('This module provides the SDC component and bridging logic for the Video Carousel Lego. To fully configure the block types and fields, you must apply the associated recipe.') . '</p>';
    $output .= '<h3>' . t('Installation Instructions') . '</h3>';
    $output .= '<p>' . t('To install the pre-configured Video Carousel block type, you must run the following Drush command from your project root:') . '</p>';
    $output .= '<pre><code>' . $command . '</code></pre>';
    return $output;
  }
  return '';
}

/**
 * Implements hook_theme().
 *
 * Registers a specific theme hook suggestion to route the Video Carousel block
 * content entity directly to our custom `block--lego-video-carousel.html.twig`
 * template, where the Bootstrap 5 SDC is embedded.
 */
function leap_lego_video_carousel_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'block__block_content__type__video_carousel' => [
      'base hook' => 'block',
      'template' => 'block--lego-video-carousel',
    ],
    'leap_video_duration' => [
      'variables' => ['display' => NULL, 'spoken' => NULL, 'iso' => NULL],
      'template' => 'leap-video-duration',
    ],
    'media__remote_video__carousel' => ['base hook' => 'media', 'template' => 'media--remote-video--carousel'],
    'media__remote_video__carousel_detailed' => ['base hook' => 'media', 'template' => 'media--remote-video--carousel-detailed'],
    'media__video__carousel' => ['base hook' => 'media', 'template' => 'media--video--carousel'],
    'media__video__carousel_detailed' => ['base hook' => 'media', 'template' => 'media--video--carousel-detailed'],
  ];
}

/**
 * Implements hook_preprocess_media().
 *
 * Supplies the detailed card's computed text; the fields it prints come from
 * the display.
 */
function leap_lego_video_carousel_preprocess_media(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'carousel_detailed') {
    return;
  }
  $media = $variables['media'] ?? NULL;
  if (!$media instanceof \Drupal\media\MediaInterface) {
    return;
  }
  $variables['video_title'] = \Drupal\leap_lego_video_carousel\VideoMetadata::title($media);
  $variables['video_provider'] = \Drupal\leap_lego_video_carousel\VideoMetadata::providerName($media);
}

/**
 * Implements hook_preprocess_glightbox_media_remote_video_formatter().
 *
 * For the lightbox opt-in: names the poster link. Never fires without
 * glightbox_media_video. Runs after the formatter's own preprocess, which sets
 * the title tooltip and data-glightbox string this replaces.
 */
function leap_lego_video_carousel_preprocess_glightbox_media_remote_video_formatter(array &$variables): void {
  _leap_lego_video_carousel_name_poster_link($variables);
}

/**
 * Implements hook_preprocess_glightbox_media_file_video_formatter().
 */
function leap_lego_video_carousel_preprocess_glightbox_media_file_video_formatter(array &$variables): void {
  _leap_lego_video_carousel_name_poster_link($variables);
}

/**
 * Sets the accessible name and lightbox caption on a GLightbox poster link.
 */
function _leap_lego_video_carousel_name_poster_link(array &$variables): void {
  $media = $variables['entity'] ?? NULL;
  if (!$media instanceof \Drupal\media\MediaInterface) {
    return;
  }
  $title = \Drupal\leap_lego_video_carousel\VideoMetadata::title($media);
  if ($title === '') {
    return;
  }
  unset($variables['attributes']['title'], $variables['attributes']['data-glightbox']);
  $attributes = \Drupal\leap_lego_video_carousel\VideoMetadata::linkAttributes(
    $title,
    \Drupal\leap_lego_video_carousel\VideoMetadata::summary($media),
    \Drupal\leap_lego_video_carousel\VideoMetadata::duration($media),
  );
  foreach ($attributes as $name => $value) {
    $variables['attributes'][$name] = $value;
  }
}

/**
 * Chooses the media view mode for a block view mode.
 *
 * Layout Builder's inline block form defaults to `full`, so only an explicit
 * `detailed` selects the detailed card.
 */
function leap_lego_video_carousel_media_view_mode(string $block_view_mode): string {
  return $block_view_mode === 'detailed' ? 'carousel_detailed' : 'carousel';
}

/**
 * Implements hook_preprocess_block().
 *
 * Preprocesses the parent Video Carousel block.
 * Iterates through the directly referenced Media entities (Videos) and
 * programmatically renders them using the entity view builder. This ensures
 * that core oEmbed logic (for YouTube/Vimeo) or native HTML5 `<video>`
 * tags are fully rendered before being passed to the SDC carousel slides.
 */
function leap_lego_video_carousel_preprocess_block(array &$variables): void {
  $content = $variables['content'];

  // Ensure the block content entity is available.
  if (!isset($content['#block_content'])) {
    return;
  }

  /** @var \Drupal\block_content\Entity\BlockContent $block */
  $block = $content['#block_content'];
	if ($block->bundle() === 'video_carousel') {
		// Generate a unique base ID for the Bootstrap carousel controls.
		$variables['carousel_id'] = 'carousel-' . $block->id();

		$items = [];
		// Verify the block has the expected entity reference field.
		if ($block->hasField('field_videos')) {
			$view_builder = \Drupal::entityTypeManager()->getViewBuilder('media');

			// Loop directly over the media entities attached to the block.
			// Unlike the Image Carousel, videos are usually just the player,
			// so we skip the Paragraph wrapper and render the media directly.
			$media_view_mode = leap_lego_video_carousel_media_view_mode((string) ($content['#view_mode'] ?? ''));
			foreach ($block->get('field_videos')->referencedEntities() as $media_entity) {
				$build = $view_builder->view($media_entity, $media_view_mode);
				$html = (string) \Drupal::service('renderer')->render($build);
				$items[] = [
					'media' => \Drupal\Core\Render\Markup::create(
						\Drupal\leap_lego_video_carousel\VideoMetadata::scopeGallery($html, $variables['carousel_id'])
					),
				];
			}
		}

		// Inject the mapped array into the variables array for Twig.
		$variables['carousel_items'] = $items;
	}
}
