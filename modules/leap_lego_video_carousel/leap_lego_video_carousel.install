<?php

/**
 * @file
 */

declare(strict_types=1);

/**
 * @file
 * Installation and update functions for the LEAP Lego - Video Carousel module.
 */

/**
 * Implements hook_install().
 *
 * Provides a post-installation messenger alert with the required Drush recipe
 * command to attach the necessary media reference fields and block configuration.
 * Because LEAP Legos use pure configuration recipes rather than config/install
 * directories, this manual prompt is essential for the site builder workflow.
 */
function leap_lego_video_carousel_install(): void {
  // Dynamically determine the path for the recipe command.
  $module_path = \Drupal::service('extension.list.module')->getPath('leap_lego_video_carousel');
  $command = "drush recipe $module_path/recipes/leap_lego_video_carousel";

  \Drupal::messenger()->addWarning(t('The Splash Frog Legos - Video Carousel module has been enabled. <strong>To complete the setup, apply the Splash Frog media types recipe (<code>leap_media</code>) if you have not, then this recipe:</strong><br><br><code>@command</code><br><br>Videos play inline. To open them in a lightbox instead, install <code>glightbox</code> and <code>glightbox_media_video</code> and apply <code>@lightbox</code>.', [
    '@command' => $command,
    '@lightbox' => "drush recipe $module_path/recipes/leap_lego_video_carousel_lightbox",
  ]));
}
