<?php

/**
 * @file
 */

declare(strict_types=1);

/**
 * @file
 * Installation and update functions for the LEAP Lego - Sibling Nav module.
 */

/**
 * Implements hook_install().
 *
 * Provides a post-installation messenger alert with the required Drush recipe
 * command to attach the necessary block type configuration and view imports.
 * Because LEAP Legos use pure configuration recipes rather than config/install
 * directories, this manual prompt is essential for the site builder workflow.
 */
function leap_lego_sibling_nav_install(): void {
  // Dynamically determine the path for the recipe command.
  $module_path = \Drupal::service('extension.list.module')->getPath('leap_lego_sibling_nav');
  $command = "drush recipe $module_path/recipes/leap_lego_sibling_nav";

  \Drupal::messenger()->addWarning(t('The Splash Frog Legos - Sibling / Smart Navigation module has been enabled. <strong>To complete the setup, you must apply the associated recipe:</strong><br><br><code>@command</code>', [
    '@command' => $command,
  ]));
}
