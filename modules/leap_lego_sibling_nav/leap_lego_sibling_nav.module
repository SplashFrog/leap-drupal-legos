<?php

/**
 * @file
 */

declare(strict_types=1);

/**
 * @file
 * Hook implementations for the LEAP Lego - Sibling Nav module.
 *
 * This module acts as the bridge between Drupal's backend data structures
 * and the frontend Single Directory Component (SDC) templates for the Sibling/Smart
 * Navigation Lego. It handles preprocessing, theme hook suggestions, and crucially,
 * view argument injections to dynamically build sub-navigation trees based on the
 * current active trail.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_help().
 *
 * Provides instructions to site builders on how to complete the installation
 * of the Sibling Nav Lego by applying the accompanying Drupal Recipe.
 */
function leap_lego_sibling_nav_help(string $route_name, RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.leap_lego_sibling_nav') {
    $module_path = \Drupal::service('extension.list.module')->getPath('leap_lego_sibling_nav');
    $command = "drush recipe $module_path/recipes/leap_lego_sibling_nav";

    $output = '<h3>' . t('About') . '</h3>';
    $output .= '<p>' . t('This module provides the SDC component and bridging logic for the Sibling / Smart Navigation Lego. To fully configure the block types and fields, you must apply the associated recipe.') . '</p>';
    $output .= '<h3>' . t('Installation Instructions') . '</h3>';
    $output .= '<p>' . t('To install the pre-configured Sibling / Smart Navigation block type, you must run the following Drush command from your project root:') . '</p>';
    $output .= '<pre><code>' . $command . '</code></pre>';
    return $output;
  }
  return '';
}

/**
 * Implements hook_theme().
 *
 * Registers a specific theme hook suggestion to route the Sibling Nav block
 * content entity directly to our custom `block--lego-sibling-nav.html.twig`
 * template, where the SDC is embedded.
 */
function leap_lego_sibling_nav_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'block__block_content__sibling_nav' => [
      'base hook' => 'block',
      'template' => 'block--lego-sibling-nav',
    ],
  ];
}

/**
 * Implements hook_preprocess_block().
 *
 * Preprocesses the parent Sibling Nav block.
 * Programmatically renders the embedded View block and passes the resulting
 * HTML markup directly into the SDC component wrapper.
 */
function leap_lego_sibling_nav_preprocess_block__block_content__sibling_nav(array &$variables): void {
  $content = $variables['content'];

  // Ensure the block content entity is available.
  if (!isset($content['#block_content'])) {
    return;
  }

  /** @var \Drupal\block_content\Entity\BlockContent $block */
  $block = $content['#block_content'];

  $nav_content = '';
  // Check if the block has the embedded view field.
  if ($block->hasField('field_sibling_nav') && !$block->get('field_sibling_nav')->isEmpty()) {
    $view_builder = \Drupal::entityTypeManager()->getViewBuilder('block_content');
    $field_render = $view_builder->viewField($block->get('field_sibling_nav'), 'default');
    $nav_content = \Drupal::service('renderer')->render($field_render) ?? '';
  }

  // Inject the rendered view HTML into the variables array for Twig.
  $variables['nav_content'] = $nav_content;
}

/**
 * Implements hook_views_pre_view().
 *
 * Dynamically injects the parent Node ID into the View as a contextual filter.
 *
 * Logic Branches:
 * 1. Auto Navigation (`lego_auto_nav`): Inspects the current page's URL to find
 *    the active Node, checks its `field_parent_content`, and uses that target ID
 *    to find siblings.
 * 2. Manual Navigation (`lego_sibling_nav`): Relies on a statically configured
 *    argument passed directly from the block placement.
 */
function leap_lego_sibling_nav_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  // Only target the specific sibling_nav view.
  if ($view->id() !== 'sibling_nav') {
    return;
  }

  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $isPublished = FALSE;
  $parentId = NULL;

  // Branch 1: Auto Navigation (dynamic context)
  if ($display_id === 'lego_auto_nav') {
    $currentNode = \Drupal::routeMatch()->getParameter('node');
    if ($currentNode instanceof NodeInterface && $currentNode->hasField('field_parent_content') && !$currentNode->get('field_parent_content')->isEmpty()) {
      $parentId = $currentNode->get('field_parent_content')->target_id;
    }
  }

  // Branch 2: Manual Sibling Navigation (static context via block argument)
  if ($display_id === 'lego_sibling_nav') {
    $parentId = $args[0] ?? NULL;
  }

  // Security & Validity Check: If we found a parent ID, ensure the parent node
  // actually exists and is currently published. If it's unpublished, we don't
  // want to reveal its children in the navigation.
  if ($parentId) {
    /** @var \Drupal\node\NodeInterface $parentPage */
    $parentPage = $node_storage->load($parentId);
    if ($parentPage instanceof NodeInterface) {
      $isPublished = _leap_lego_sibling_nav_parent_page_published($parentPage);
    }
  }

  // Injection: Pass the valid ID to the View's contextual filter.
  // If validation failed, pass '0' to safely force the View to return empty results.
  $args[0] = $isPublished ? (string) $parentId : '0';
}

/**
 * Helper function to determine if a parent node is published.
 *
 * Evaluates both the core status flag and Content Moderation workflows
 * (specifically preventing 'archived' nodes from passing the check).
 *
 * @param \Drupal\node\NodeInterface $parentNode
 *   The node to evaluate.
 *
 * @return bool
 *   TRUE if the Node is Published and not archived. FALSE otherwise.
 */
function _leap_lego_sibling_nav_parent_page_published(NodeInterface $parentNode): bool {
  // If it's unpublished at the core level, fail immediately.
  if (!$parentNode->isPublished()) {
    return FALSE;
  }

  // If using content moderation, ensure it is not explicitly archived.
  // Some systems leave the core status as published while the moderation state is archived.
  if ($parentNode->hasField('moderation_state') && !$parentNode->get('moderation_state')->isEmpty()) {
    return $parentNode->get('moderation_state')->value !== 'archived';
  }

  return TRUE;
}
