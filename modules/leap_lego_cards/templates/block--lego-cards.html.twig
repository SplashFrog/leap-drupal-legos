{#
/**
 * @file
 * Default module theme implementation for the cards block content type.
 */
#}
{% set block_classes = [
  'block',
  'block-' ~ configuration.provider|clean_class,
  'block-' ~ plugin_id|clean_class,
  layout ? 'layout--' ~ layout|clean_class,
] %}

<div{{ attributes.addClass(block_classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% include 'leap_lego_cards:card' with {
    'title': content.field_title[0]['#context']['value']|default(''),
    'body': content.body[0]|default(''),
    'media': content.field_media|default(''),
    'link_url': card_link_url|default(''),
    'link_title': card_link_title|default(''),
    'link_wrap': card_link_wrap|default(false)
  } only %}
</div>
